# Utilizador e password do login (muda aqui e faz: docker compose up -d)
ADMIN_USER=andre
ADMIN_PASSWORD=muda-esta-password

# Chave para assinar as sessões (gera uma com: openssl rand -hex 32)
JWT_SECRET=troca-isto-por-uma-chave-grande-e-aleatoria

# Quanto tempo dura a sessão
SESSION_HOURS=12

# Portas no servidor (só em 127.0.0.1, o nginx é que expõe)
FRONTEND_PORT=5180
BACKEND_PORT=7020
